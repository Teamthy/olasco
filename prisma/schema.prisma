generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum City {
  LAGOS
  ABUJA
}

enum VehicleCategory {
  ECONOMY
  SEDAN
  SUV
  LUXURY
  EXECUTIVE
  VAN
  CONVERTIBLE
  SPORTS
}

enum BookingStatus {
  PENDING
  CONTACTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RentalServiceType {
  DAILY_RENTAL
  LONG_TERM_RENTAL
  INTERSTATE_TRIP
}

enum PickupServiceType {
  AIRPORT_PICKUP
  CHAUFFEUR
  CORPORATE_TRAVEL
  EVENT_TRANSPORT
  INTERSTATE_TRIP
  CITY_TRANSFER
}

enum InquiryType {
  PURCHASE_CONSULTATION
  SELL_TRADE_IN
  GENERAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum UserRole {
  ADMIN
  OPERATIONS
  SALES
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(OPERATIONS)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]

  @@index([role, isActive])
}

model Vehicle {
  id                 String           @id @default(cuid())
  slug               String           @unique
  make               String
  model              String
  trim               String?
  year               Int
  category           VehicleCategory
  description        String
  currency           String           @default("NGN")
  rentalPriceDaily   Decimal?         @db.Decimal(12, 2)
  rentalPriceWeekly  Decimal?         @db.Decimal(12, 2)
  salePrice          Decimal?         @db.Decimal(12, 2)
  location           City
  seats              Int?
  doors              Int?
  transmission       String?
  fuelType           String?
  color              String?
  mileage            Int?
  features           String[]         @default([])
  isForRent          Boolean          @default(false)
  isForSale          Boolean          @default(false)
  isFeatured         Boolean          @default(false)
  isAvailable        Boolean          @default(false)
  isPublished        Boolean          @default(false)
  images             VehicleImage[]
  bookings           Booking[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([location, category, isPublished])
  @@index([isAvailable, isPublished])
  @@index([isForRent, isPublished])
  @@index([isForSale, isPublished])
}

model VehicleImage {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url           String
  altText       String
  sortOrder     Int      @default(0)
  sourceCredit  String?
  createdAt     DateTime @default(now())

  @@index([vehicleId, sortOrder])
}

model Customer {
  id             String    @id @default(cuid())
  fullName       String
  phone          String    @unique
  whatsappNumber String?
  email          String?
  bookings       Booking[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
}

model Booking {
  id               String            @id @default(cuid())
  reference        String            @unique
  idempotencyKey   String            @unique
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId        String?
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  requestedVehicle String?
  serviceType      RentalServiceType
  location         City
  serviceArea      String?
  pickupDate       DateTime          @db.Date
  returnDate       DateTime          @db.Date
  pickupTime       String
  pickupAddress    String
  destination      String?
  passengers       Int               @default(1)
  driverRequired   Boolean           @default(false)
  specialRequest   String?
  status           BookingStatus     @default(PENDING)
  privacyConsentAt DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([vehicleId, pickupDate, returnDate])
}

model BookingCounter {
  year  Int @id
  value Int @default(0)
}

model Inquiry {
  id                 String       @id @default(cuid())
  reference          String       @unique
  fullName           String
  phone              String
  email              String?
  type               InquiryType
  city               City?
  serviceArea        String?
  preferredVehicle   String?
  budget             String?
  message            String
  status             InquiryStatus @default(NEW)
  privacyConsentAt   DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([phone])
}

model PickupRequest {
  id               String           @id @default(cuid())
  reference        String           @unique
  fullName         String
  phone            String
  email            String?
  serviceType      PickupServiceType
  city             City
  serviceArea      String?
  pickupDate       DateTime         @db.Date
  pickupTime       String
  returnDate       DateTime?        @db.Date
  pickupAddress    String
  destination      String
  passengers       Int              @default(1)
  luggage          String?
  specialRequest   String?
  status           BookingStatus    @default(PENDING)
  privacyConsentAt DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([city, pickupDate])
  @@index([phone])
}

model ContactMessage {
  id               String   @id @default(cuid())
  reference        String   @unique
  fullName         String
  phone            String
  email            String?
  subject          String
  city             City?
  serviceArea      String?
  message          String
  privacyConsentAt DateTime
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([phone])
}

model Location {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  city           City     @unique
  publicAddress  String?
  phone          String?
  email          String?
  openingHours   String?
  googleMapsUrl  String?
  coverageNotes  String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
