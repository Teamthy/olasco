# Public URL for metadata, canonical links, and sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Customer-facing WhatsApp chat number; international digits only (Nigeria: +234...).
NEXT_PUBLIC_WHATSAPP_NUMBER=2348151594253
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_LAGOS_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Lagos%2C%20Nigeria
NEXT_PUBLIC_ABUJA_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Abuja%2C%20Nigeria

# Required in production. Local development can use the ignored JSON adapter if blank.
DATABASE_URL=

# Optional SMTP admin email notifications. Credentials remain server-side.
EMAIL_PROVIDER=none
EMAIL_FROM=
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Optional WhatsApp Cloud API admin notifications; distinct from click-to-chat.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_GRAPH_API_VERSION=

# Optional HTTPS Redis REST endpoint and bearer token for a shared atomic limiter.
# If both are blank, the app falls back to a per-process limiter; if only one is set,
# or Redis is unavailable, API requests fail closed with HTTP 503.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
